# ==============================================================================
# MicroCOCK OS - Doxygen Configuration File
# ==============================================================================

# ------------------------------------------------------------------------------
# Project Identity
# ------------------------------------------------------------------------------
PROJECT_NAME           = "MicroCOCK OS"
PROJECT_NUMBER         = "v0.0.6 Pre-alfa"
PROJECT_BRIEF          = "32-bit x86 Higher-Half Microkernel"
PROJECT_LOGO           = 

# ------------------------------------------------------------------------------
# Input / Output Settings
# ------------------------------------------------------------------------------
OUTPUT_DIRECTORY       = documentation/api

INPUT                  = cock/ \
                         shared/ \
                         libc/ \
                         libcxx/ \
                         userland/ \
                         documentation/ \
                         README.md

USE_MDFILE_AS_MAINPAGE = README.md

RECURSIVE              = YES

FILE_PATTERNS          = *.c \
                         *.cpp \
                         *.h \
                         *.hpp \
                         *.md

EXCLUDE                = build/

# ------------------------------------------------------------------------------
# Extraction and Parsing Behavior
# ------------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

OPTIMIZE_OUTPUT_FOR_C  = YES

# Parse macros so things like __attribute__((packed)) don't break the parser
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# Strip the absolute path from the documentation so it looks clean
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = shared/include/ \
                         libc/include/ \
                         libcxx/include/

# ------------------------------------------------------------------------------
# Output Formats
# ------------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES

GENERATE_LATEX         = NO

GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

# ------------------------------------------------------------------------------
# Markdown Support
# ------------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 0

# ------------------------------------------------------------------------------
# Diagrams (Optional: Requires Graphviz installed on your host OS)
# ------------------------------------------------------------------------------
# Set this to YES if you have Graphviz/dot installed. It will generate beautiful
# dependency graphs and class inheritance diagrams automatically.
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
